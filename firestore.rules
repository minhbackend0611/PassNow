rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Quy tắc cho collection users
    match /users/{userId} {
      // Bất kỳ ai đăng nhập đều có thể xem profile người khác
      allow read: if request.auth != null;
      
      // Cho phép chủ sở hữu toàn quyền
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      
      // Cho phép cập nhật nếu là chủ sở hữu HOẶC chỉ cập nhật rating và totalReviews
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalReviews']))
      );
    }

    // Quy tắc cho collection listings (sản phẩm)
    match /listings/{listingId} {
      // Bất kỳ ai cũng có thể xem sản phẩm
      allow read: if true;
      // Chỉ người đăng nhập mới được tạo sản phẩm, và chỉ chủ sản phẩm mới được sửa/xóa
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // Quy tắc cho collection chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Quy tắc cho collection transactions
    match /transactions/{transactionId} {
      allow get: if request.auth != null && (
        resource == null || 
        request.auth.uid == resource.data.buyerId || 
        request.auth.uid == resource.data.sellerId
      );
      allow list: if request.auth != null && (
        request.auth.uid == resource.data.buyerId || 
        request.auth.uid == resource.data.sellerId
      );
      
      // Cho phép người mua tạo yêu cầu giao dịch
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      
      // Cho phép cập nhật/xoá nếu user là người mua hoặc người bán
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
    }

    // Quy tắc cho collection reviews
    match /reviews/{reviewId} {
      // Ai cũng có thể đọc đánh giá
      allow read: if true;
      
      // Chỉ người tạo đánh giá mới được quyền tạo
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
      
      // Chỉ người tạo đánh giá mới được quyền sửa hoặc xoá
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.reviewerId;
    }
  }
}
